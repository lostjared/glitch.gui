	$(MAKE) $(MAKESILENT) -f CMakeFiles/stutter_sbrv.dir/build.make CMakeFiles/stutter_sbrv.dir/stutter_sbrv/plugin.cpp.i
.PHONY : stutter_sbrv/plugin.cpp.i

stutter_sbrv/plugin.s: stutter_sbrv/plugin.cpp.s
.PHONY : stutter_sbrv/plugin.s

# target to generate assembly for a file
stutter_sbrv/plugin.cpp.s:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/stutter_sbrv.dir/build.make CMakeFiles/stutter_sbrv.dir/stutter_sbrv/plugin.cpp.s
.PHONY : stutter_sbrv/plugin.cpp.s

